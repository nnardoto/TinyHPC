#!/usr/bin/env bash
set -o pipefail

# Resolve the repository root from this script's location (following symlinks)
# so the CLI works from any directory, including via the /usr/local/bin/hpc link.
script="$(readlink -f "${BASH_SOURCE[0]}")"
repo="$(cd "$(dirname "$script")/.." && pwd -P)"
unset script
export TINYHPC_HOME="$repo"
export TINYHPC_REPO="$repo"

hpc_die() {
    printf 'ERROR: %s\n' "$*" >&2
    exit 1
}

hpc_note() {
    printf '==> %s\n' "$*"
}

hpc_find_python() {
    local candidate
    for candidate in python3.13 python3.12 python3.11 python3.10 python3.9 python3; do
        command -v "$candidate" >/dev/null 2>&1 || continue
        if "$candidate" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 9) else 1)' 2>/dev/null; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    hpc_die "Python 3.9 ou mais recente não encontrado"
}

hpc_python="$(hpc_find_python)"
hpc_recipe="$repo/lib/recipe.py"

recipe() {
    "$hpc_python" "$hpc_recipe" --repo "$repo" "$@"
}

# Load the effective configuration through the Python parser and export it,
# so Bash never duplicates TOML parsing. The environment subcommand emits
# tab-separated KEY<TAB>VALUE lines that are assigned and exported below.
settings="$(recipe environment)" || hpc_die "não foi possível carregar a configuração"
while IFS=$'\t' read -r key value; do
    [[ -n "$key" ]] || continue
    printf -v "$key" '%s' "$value"
    export "$key"
done <<< "$settings"
unset settings key value

# Make the "module" command available once per process, preferring an explicit
# TINYHPC_LMOD_INIT override before probing common Lmod install locations.
hpc_init_lmod() {
    if type module >/dev/null 2>&1; then
        return 0
    fi

    local init candidate
    local -a candidates=()

    if [[ -n "${TINYHPC_LMOD_INIT:-}" ]]; then
        candidates+=("$TINYHPC_LMOD_INIT")
    fi

    candidates+=(
        /usr/share/lmod/lmod/init/bash
        /etc/profile.d/lmod.sh
        /usr/local/lmod/lmod/init/bash
    )

    for candidate in "${candidates[@]}"; do
        [[ -r "$candidate" ]] || continue
        init="$candidate"
        # shellcheck disable=SC1090
        source "$init" >/dev/null 2>&1 || continue
        type module >/dev/null 2>&1 && return 0
    done

    return 1
}

hpc_require_lmod() {
    hpc_init_lmod || hpc_die "Lmod não encontrado ou não pôde ser inicializado"
}

hpc_require_layout() {
    local directory
    for directory in "$HPC_CACHE" "$HPC_SRC" "$HPC_BUILD" "$HPC_SOFTWARE" "$HPC_MODULEFILES" "$HPC_LOGS"; do
        [[ -d "$directory" ]] || hpc_die "$directory não existe; rode o bootstrap do TinyHPC"
    done
}

# Install one spec and everything it needs, in topological order.
hpc_install_spec() {
    local spec="$1" plan item dependencies dependency log
    local -a plan_items dependency_items
    plan="$(recipe plan "$spec")" || return 1
    mapfile -t plan_items <<< "$plan"

    hpc_require_lmod
    module purge || return 1
    module use "$HPC_MODULEFILES" || return 1
    export TINYHPC_HOST_LD_LIBRARY_PATH="${LD_LIBRARY_PATH:-}"

    # The plan lists dependencies before their dependents, so a single forward
    # pass always has each package's modules loaded before its own build.
    for item in "${plan_items[@]}"; do
        [[ -n "$item" ]] || continue
        if recipe installed "$item"; then
            recipe sync-module "$item" || return 1
            hpc_note "$item já instalado"
            continue
        fi

        # Purge before each build so modules from earlier items cannot leak
        # into this item's dependency set or build environment.
        module purge || return 1
        module use "$HPC_MODULEFILES" || return 1
        dependencies="$(recipe dependencies "$item")" || return 1
        mapfile -t dependency_items <<< "$dependencies"
        for dependency in "${dependency_items[@]}"; do
            [[ -n "$dependency" ]] || continue
            module load "$dependency" || hpc_die "não foi possível carregar módulo de $dependency"
        done

        # Key the log by the slash-separated spec, with slashes replaced by dashes.
        log="$HPC_LOGS/${item//\//-}.log"
        hpc_note "instalando $item"
        recipe install-one "$item" 2>&1 | tee "$log"
        [[ ${PIPESTATUS[0]} -eq 0 ]] || hpc_die "build falhou: $item"
    done
}

case "${1:-}" in
    list)
        recipe list
        ;;
    compilers)
        [[ $# -eq 1 ]] || hpc_die "uso: hpc compilers"
        recipe compilers
        ;;
    compiler)
        [[ $# -le 2 ]] || hpc_die "uso: hpc compiler [<compiler-spec>|--clear]"
        case "${2:-}" in
            "") recipe compiler-current ;;
            --clear) recipe compiler-clear ;;
            *) recipe compiler-set "$2" ;;
        esac
        ;;
    resolve)
        [[ $# -ge 2 ]] || hpc_die "uso: hpc resolve [-v] <query>"
        recipe resolve "${@:2}"
        ;;
    info)
        [[ $# -ge 2 ]] || hpc_die "uso: hpc info <spec>"
        recipe info "$2"
        ;;
    config)
        recipe config
        ;;
    env)
        shell="${2:-bash}"
        if [[ "$shell" == "--shell" ]]; then shell="${3:-}"; fi
        [[ -n "$shell" ]] || hpc_die "uso: hpc env [--shell bash|zsh|fish]"
        recipe environment --shell "$shell"
        ;;
    plan)
        [[ $# -ge 2 ]] || hpc_die "uso: hpc plan <spec>"
        recipe plan "$2"
        ;;
    validate)
        if [[ $# -ge 2 ]]; then recipe validate "$2"; else recipe validate; fi
        ;;
    new)
        [[ $# -ge 2 ]] || hpc_die "uso: hpc new <spec> [--build-system tipo]"
        recipe new "${@:2}"
        ;;
    lock)
        hpc_require_layout
        [[ $# -ge 2 ]] || hpc_die "uso: hpc lock <spec>"
        recipe lock "$2"
        ;;
    install)
        [[ $# -eq 2 ]] || hpc_die "uso: hpc install <spec>"
        resolved_spec="$(recipe resolve "$2")" || exit 1
        hpc_require_layout
        hpc_install_spec "$resolved_spec"
        ;;
    clean)
        [[ $# -ge 2 ]] || hpc_die "uso: hpc clean <spec>"
        recipe clean "$2"
        ;;
    remove)
        [[ $# -ge 2 ]] || hpc_die "uso: hpc remove <spec>"
        recipe remove "$2"
        ;;
    doctor)
        hpc_require_layout
        printf 'TINYHPC_HOME=%s\n' "$TINYHPC_HOME"
        printf 'TINYHPC_ROOT=%s\n' "$TINYHPC_ROOT"
        printf 'HPC_JOBS=%s\n' "$HPC_JOBS"
        printf '%-12s %s\n' python "$("$hpc_python" --version 2>&1)"
        for command_name in bash curl tar sha256sum make patch cmp cmake; do
            if command -v "$command_name" >/dev/null 2>&1; then
                printf '%-12s OK\n' "$command_name"
            else
                printf '%-12s MISSING\n' "$command_name"
            fi
        done
        if hpc_init_lmod; then
            printf '%-12s OK\n' module
        else
            printf '%-12s MISSING\n' module
        fi
        ;;
    *)
        echo "hpc {list|compilers|compiler|resolve|info|config|env|plan|validate|new|lock|install|clean|remove|doctor} [spec]"
        exit 1
        ;;
esac
