+         use para, only : dp
+         implicit none
+         character(len=1), intent(in) :: transa
+         integer, intent(in) :: m
+         complex(dp), intent(in) :: val(*)
+         integer, intent(in) :: indx(*)
+         integer, intent(in) :: indx2(*)
+         complex(dp), intent(in) :: x(*)
+         complex(dp), intent(out) :: y(*)
+         integer :: i, j
+
+         if (transa == 'N' .or. transa == 'n') then
+            do i = 1, m
+               y(i) = 0d0
+               do j = indx(i), indx(i+1) - 1
+                  y(i) = y(i) + val(j) * x(indx2(j))
+               enddo
+            enddo
+         else
+            do i = 1, m
+               y(i) = 0d0
+            enddo
+            do i = 1, m
+               do j = indx(i), indx(i+1) - 1
+                  y(indx2(j)) = y(indx2(j)) + val(j) * x(i)
+               enddo
+            enddo
+         endif
+         return
+      end subroutine mkl_zcsrgemv
